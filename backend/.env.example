MONGO_URI=mongodb://localhost:27017
DB_NAME=news_pulse
PORT=5000

# Path to the Python interpreter and the scraper's entry script.
# Locally these point at your machine; in deployment they're set by
# whatever platform runs the backend (see README for details).
PYTHON_PATH=python
PYTHON_SCRIPT=/absolute/path/to/News-Pulse/scraper/main.py

# Where the frontend runs, for CORS.
FRONTEND_URL=http://localhost:3000
